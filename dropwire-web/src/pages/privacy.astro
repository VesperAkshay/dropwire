---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy Policy — DropWire">
  <section class="p-6 sm:p-12 space-y-12">
    <div class="max-w-4xl space-y-4">
      <span class="text-xs font-mono text-[#0052FF] uppercase tracking-widest font-black">ZERO-DATA POLICY</span>
      <h1 class="text-5xl sm:text-7xl font-display font-black text-[#0B1016] uppercase tracking-tight leading-none">
        Privacy Policy
      </h1>
      <p class="text-lg text-[#0B1016]/80 font-sans font-medium">
        DropWire does not collect, store, track, or monetise any personal data or file transfers.
      </p>
    </div>

    <div class="bg-[#FFFFFF] p-8 sm:p-12 rounded-[2.5rem] card-shadow border border-[#D9D2C9] space-y-6 text-[#0B1016] font-sans font-medium leading-relaxed">
      <h2 class="text-3xl font-black font-display uppercase">1. Zero Telemetry & Analytics</h2>
      <p>
        DropWire CLI contains zero telemetry, zero analytics tracking SDKs, and zero crash pingback servers.
      </p>

      <h2 class="text-3xl font-black font-display uppercase pt-4">2. Non-Custodial Encrypted Transfers</h2>
      <p>
        All byte transfers stream directly machine-to-machine. Unencrypted data is never written to cloud storage or held by intermediate relay servers.
      </p>

      <h2 class="text-3xl font-black font-display uppercase pt-4">3. Website Analytics</h2>
      <p>
        This marketing website is statically hosted on Cloudflare Pages without third-party tracking cookies or invasive user fingerprinting scripts.
      </p>
    </div>
  </section>
</BaseLayout>


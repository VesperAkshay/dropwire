---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — DropWire Blog`}>
  <section class="p-6 sm:p-12 space-y-8">
    <a href="/blog" class="inline-flex items-center gap-2 font-mono text-xs font-black text-[#0052FF] hover:underline">
      ← Back to Blog Hub
    </a>

    <div class="bg-[#FFFFFF] p-8 sm:p-12 rounded-[2.5rem] card-shadow border border-[#D9D2C9] space-y-6">
      <div class="border-b-2 border-[#F4EFEA] pb-6 space-y-4">
        <div class="flex items-center justify-between text-xs font-mono font-black">
          <span class="text-[#0052FF] uppercase">{post.data.author || 'DropWire Team'}</span>
          <span class="text-[#0B1016]/60">{new Date(post.data.pubDate).toLocaleDateString()}</span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl font-display font-black text-[#0B1016] uppercase leading-tight">
          {post.data.title}
        </h1>
        <p class="text-base text-[#0B1016]/80 font-sans font-medium">
          {post.data.description}
        </p>
      </div>

      <div class="prose prose-lg max-w-none text-[#0B1016] font-sans prose-headings:font-display prose-headings:font-black prose-headings:uppercase prose-headings:text-[#0B1016] prose-code:text-[#0052FF] prose-code:font-mono prose-pre:bg-[#F4EFEA] prose-pre:border prose-pre:border-[#D9D2C9] prose-pre:text-[#0B1016]">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

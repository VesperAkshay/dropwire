---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
---

<BaseLayout title="Blog — DropWire">
  <section class="p-6 sm:p-12 space-y-12">
    <div class="max-w-4xl space-y-4">
      <span class="text-xs font-mono text-[#0052FF] uppercase tracking-widest font-black">ENGINEERING & PRODUCT UPDATES</span>
      <h1 class="text-5xl sm:text-7xl font-display font-black text-[#0B1016] uppercase tracking-tight leading-none">
        DropWire Blog
      </h1>
      <p class="text-lg text-[#0B1016]/80 font-sans font-medium">
        Deep dives into Rust P2P networking, SPAKE2 cryptography, Multiplexed TCP transport, and non-custodial software design.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="group rounded-[2.5rem] p-8 sm:p-10 bg-[#FFFFFF] border-2 border-[#D9D2C9] hover:border-[#0052FF] shadow-xl space-y-6 transition-all transform hover:-translate-y-1 flex flex-col justify-between"
        >
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs font-mono font-black">
              <span class="text-[#0052FF] uppercase">{post.data.author || 'DropWire Team'}</span>
              <span class="text-[#0B1016]/60">{new Date(post.data.pubDate).toLocaleDateString()}</span>
            </div>

            <h2 class="text-3xl font-black font-display text-[#0B1016] uppercase group-hover:text-[#0052FF] transition-colors leading-tight">
              {post.data.title}
            </h2>
            <p class="text-sm font-sans font-medium text-[#0B1016]/80 leading-relaxed">
              {post.data.description}
            </p>
          </div>

          <div class="flex items-center justify-between text-xs font-mono font-black text-[#0052FF] pt-4 border-t border-[#F4EFEA]">
            <span>Read Post</span>
            <span class="text-lg group-hover:translate-x-1 transition-transform">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>


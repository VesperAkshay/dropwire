---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { id: doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
---

<BaseLayout title={`${doc.data.title} — DropWire Docs`}>
  <section class="p-6 sm:p-12 space-y-8">
    <a href="/docs" class="inline-flex items-center gap-2 font-mono text-xs font-black text-[#0052FF] hover:underline">
      ← Back to Documentation Hub
    </a>

    <div class="bg-[#FFFFFF] p-8 sm:p-12 rounded-[2.5rem] card-shadow border border-[#D9D2C9] space-y-6">
      <div class="border-b-2 border-[#F4EFEA] pb-6 space-y-3">
        <span class="text-xs font-mono font-black text-[#0052FF] uppercase">DOCUMENTATION</span>
        <h1 class="text-4xl sm:text-6xl font-display font-black text-[#0B1016] uppercase leading-tight">
          {doc.data.title}
        </h1>
        <p class="text-base text-[#0B1016]/80 font-sans font-medium">
          {doc.data.description}
        </p>
      </div>

      <div class="prose prose-lg max-w-none text-[#0B1016] font-sans prose-headings:font-display prose-headings:font-black prose-headings:uppercase prose-headings:text-[#0B1016] prose-code:text-[#0052FF] prose-code:font-mono prose-pre:bg-[#F4EFEA] prose-pre:border prose-pre:border-[#D9D2C9] prose-pre:text-[#0B1016]">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

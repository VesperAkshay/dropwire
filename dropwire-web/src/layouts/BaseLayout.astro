---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import LenisInit from '../components/motion/LenisInit';
import InteractiveMosaic from '../components/motion/InteractiveMosaic';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = `DropWire — Secure, No-Account P2P File Transfer`,
  description = "Send files instantly over your local network and the internet with zero setup. End-to-end encrypted, lightning fast peer-to-peer file transfer.",
  image = '/og-image.png',
  canonicalURL = Astro.url.href,
} = Astro.props;

const NAV_BLOCKS = [
  { num: '01', label: 'Features', href: '/features', color: 'bg-[#FF3D00] text-white hover:bg-[#E03600]' },
  { num: '02', label: 'How it Works', href: '/how-it-works', color: 'bg-[#FFB800] text-black hover:bg-[#E6A600]' },
  { num: '03', label: 'Security', href: '/security', color: 'bg-[#00B060] text-white hover:bg-[#009E56]' },
  { num: '04', label: 'Docs & CLI', href: '/docs', color: 'bg-[#0052FF] text-white hover:bg-[#0047DB]' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/brand/dropwire-logo-v2.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload Custom Fonts -->
    <link rel="preload" href="/fonts/Alfabet-Black.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/aeonikpro-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/aeonikpro-bold.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Astro View Transitions (ClientRouter) -->
    <ClientRouter />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="p2p, file transfer, end-to-end encryption, zero-knowledge, dropwire, terminal ui, command line, secure share" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="DropWire" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD Structured Data for Software Application -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "DropWire",
      "operatingSystem": "Windows, macOS, Linux",
      "applicationCategory": "UtilitiesApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "url": canonicalURL,
      "image": new URL(image, Astro.url).href,
      "softwareVersion": "0.1.0"
    })} />
  </head>
  <body class="bg-[url('/background.png')] bg-cover bg-center bg-fixed text-[#0B1016] min-h-screen antialiased selection:bg-[#FFB800] selection:text-black">
    {/* Page Transition Top Loader */}
    <div id="nprogress-custom" class="fixed top-0 left-0 h-2 bg-[#FFB800] border-b-2 border-black z-[9999] transition-all duration-300 w-0 opacity-0 pointer-events-none"></div>

    {/* Fullscreen Brand Writing Preloader (Pure HTML/JS for Zero FOUC) */}
    <div id="html-loading-screen" class="fixed inset-0 z-[9999] bg-[#F4EFEA] text-[#0B1016] flex-col items-center justify-center p-8 transition-opacity duration-1000 ease-in-out pointer-events-none opacity-100 hidden">
      <div id="html-loading-content" class="text-left space-y-4 max-w-5xl transition-all duration-1000 ease-in-out scale-100 opacity-100 filter blur-none">
        <div class="relative overflow-hidden py-2">
          <h1 id="html-loading-title" class="font-display text-7xl sm:text-[10rem] font-black tracking-tighter text-black uppercase leading-none select-none transition-all duration-[1200ms] ease-[cubic-bezier(0.65,0,0.35,1)]" style="clip-path: inset(0 100% 0 0);">
            DropWire.
          </h1>
        </div>
        <div class="relative overflow-hidden pl-2 py-1">
          <p id="html-loading-subtitle" class="font-mono text-sm sm:text-2xl text-black/60 font-bold tracking-[0.25em] uppercase transition-all duration-[1000ms] ease-[cubic-bezier(0.65,0,0.35,1)]" style="clip-path: inset(0 100% 0 0);">
            P2P ENCRYPTED ENGINE
          </p>
        </div>
      </div>
    </div>

    <script is:inline>
      (function() {
        const hasLoaded = sessionStorage.getItem('DropWire_loaded');
        const screen = document.getElementById('html-loading-screen');
        const content = document.getElementById('html-loading-content');
        const title = document.getElementById('html-loading-title');
        const subtitle = document.getElementById('html-loading-subtitle');

        if (!hasLoaded && screen) {
          // Show the screen instantly
          screen.style.display = 'flex';
          
          setTimeout(() => {
            if (title) title.style.clipPath = 'inset(0 0% 0 0)';
          }, 100);

          setTimeout(() => {
            if (subtitle) subtitle.style.clipPath = 'inset(0 0% 0 0)';
          }, 1300);

          setTimeout(() => {
            if (content) {
              content.style.transform = 'scale(0.98)';
              content.style.opacity = '0';
              content.style.filter = 'blur(12px)';
            }
            if (screen) {
              screen.style.opacity = '0';
            }
          }, 3300);

          setTimeout(() => {
            sessionStorage.setItem('DropWire_loaded', 'true');
            if (screen) screen.style.display = 'none';
          }, 4300);
        }
      })();
    </script>

    <!-- Smooth Scroll Island -->
    <LenisInit client:only="react" />

    {/* Exact Architectural Shell */}
    <div class="flex flex-col lg:flex-row min-h-screen">
      
      {/* SIDEBAR / TOP NAV */}
      <aside class="w-full lg:w-[13rem] shrink-0 lg:sticky top-0 lg:h-screen flex flex-col p-4 bg-[#F4EFEA] lg:bg-transparent border-b lg:border-b-0 lg:border-r border-[#D9D2C9] z-50">
        
        {/* Top Bar on Mobile */}
        <div class="flex items-center justify-between lg:block lg:space-y-4">
          <a href="/" class="block group" onclick="if (window.location.pathname === '/') { sessionStorage.removeItem('DropWire_loaded'); }">
            <span class="font-display text-3xl font-black tracking-tighter text-black group-hover:text-[#0052FF] transition-colors block leading-none">
              DropWire.
            </span>
            <span class="text-[8px] font-mono text-black/60 tracking-widest uppercase font-bold mt-1 hidden sm:block lg:block">
              P2P ENCRYPTED ENGINE
            </span>
          </a>
          
          <button id="mobile-menu-btn" class="lg:hidden px-3 py-2 bg-black text-white rounded-lg font-display font-black text-xs uppercase">
            Menu
          </button>
        </div>

        {/* Menu Content (Hidden on Mobile by Default) */}
        <div id="mobile-menu" class="hidden lg:flex flex-col justify-between flex-1 mt-6 lg:mt-0">
          <nav class="grid grid-cols-2 sm:grid-cols-4 lg:flex lg:flex-col items-stretch gap-2.5 pt-1">
            {NAV_BLOCKS.map((block) => (
              <a
                href={block.href}
                class={`group flex flex-col justify-between p-3 lg:p-4 rounded-xl transition-all transform hover:-translate-y-0.5 shadow-md h-24 lg:h-[calc(var(--spacing)*45)] ${block.color}`}
              >
                <div class="flex items-center justify-between w-full">
                  <span class="font-mono text-xs font-black opacity-80">{block.num}</span>
                  <span class="font-display font-black text-lg group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">
                    ↗
                  </span>
                </div>
                <span class="font-display font-black text-sm lg:text-lg tracking-tight leading-none uppercase break-words">
                  {block.label}
                </span>
              </a>
            ))}
          </nav>

          <div class="space-y-2 pt-6 lg:pt-2">
            <a
              href="/#agent-skill"
              class="flex items-center justify-between px-4 py-3 rounded-xl bg-[#0052FF] text-white font-display font-extrabold text-xs hover:bg-[#0042D0] transition-all shadow-md"
            >
              <span>Get Agent Skill</span>
              <span class="text-sm font-black">↓</span>
            </a>

            <a
              href="/download"
              class="flex items-center justify-between px-4 py-3 rounded-xl bg-[#AB54F7] text-black font-display font-extrabold text-xs hover:brightness-110 transition-all shadow-md"
            >
              <span>Get DropWire</span>
              <span class="text-sm font-black">↗</span>
            </a>

            <a
              href="/desktop"
              class="flex items-center justify-between px-4 py-3 rounded-xl bg-black text-white font-display font-extrabold text-xs hover:bg-[#FFB800] hover:text-black transition-all shadow-md group"
            >
              <span>Desktop App (Waitlist)</span>
              <span class="text-sm font-black group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform">↗</span>
            </a>

            <div class="flex items-center justify-around py-3 px-3 bg-black rounded-lg text-white">
              <a href={SITE.repo} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-[#FFB800] transition-colors">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
              </a>
              <a href="/blog" aria-label="Blog" class="font-mono text-[10px] font-black hover:text-[#FFB800] transition-colors">BLOG</a>
              <a href="/docs" aria-label="Docs" class="font-mono text-[10px] font-black hover:text-[#FFB800] transition-colors">DOCS</a>
            </div>
          </div>
        </div>
      </aside>

      {/* RIGHT MAIN SHOWCASE STAGE CANVAS */}
      <main class="flex-1 min-w-0 p-3 sm:p-5 bg-transparent text-[#0B1016] space-y-6">
        <div class="w-full">
          <slot />
        </div>

        {/* EXACT FIX.PNG FOOTER DESIGN (Interactive Mosaic Banner, Sharp Square Border) */}
        <footer class="space-y-6 pt-4">
          {/* 1. Interactive Hover Mosaic Pixel Grid Banner (Blank by default, lights up on hover) */}
          <InteractiveMosaic client:visible />

          {/* 2. Bottom Legal / Copyright Row */}
          <div class="flex flex-col md:flex-row items-center justify-between gap-4 font-sans text-xs pt-2 pb-6">
            <div class="space-y-1 text-left">
              <p class="font-display font-black text-sm text-black">© 2026 DropWire Core Development</p>
              <p class="text-black/60 font-medium">Built with high-performance Rust P2P engine.</p>
            </div>

            <div class="flex items-center gap-3">
              <a href="/about" class="px-5 py-2 rounded-full border border-black/20 hover:border-black font-bold text-black transition-colors">
                Roadmap
              </a>
              <a href="/privacy" class="px-5 py-2 rounded-full border border-black/20 hover:border-black font-bold text-black transition-colors">
                Privacy Policy
              </a>
              <a href="/security" class="px-5 py-2 rounded-full border border-black/20 hover:border-black font-bold text-black transition-colors">
                Security Spec
              </a>
            </div>
          </div>
        </footer>
      </main>

    </div>

    <script>
      // Top Loading Bar Logic
      let progressInterval;
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nprogress-custom');
        if(!bar) return;
        bar.style.transition = 'width 0.3s ease, opacity 0.3s ease';
        bar.style.opacity = '1';
        bar.style.width = '15%';
        let progress = 15;
        clearInterval(progressInterval);
        progressInterval = setInterval(() => {
          if (progress < 85) {
            progress += Math.random() * 10;
            bar.style.width = `${progress}%`;
          }
        }, 300);
      });
      
      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('nprogress-custom');
        if(!bar) return;
        clearInterval(progressInterval);
        bar.style.width = '100%';
        setTimeout(() => {
          bar.style.opacity = '0';
          setTimeout(() => { 
            bar.style.transition = 'none';
            bar.style.width = '0%'; 
          }, 300);
        }, 300);
      });

      // Mobile Menu Toggle (Persists across View Transitions)
      document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          // Remove old listeners to prevent duplicates
          const newBtn = btn.cloneNode(true);
          btn.parentNode?.replaceChild(newBtn, btn);
          
          newBtn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
          });
        }
      });

      // Copy Button Logic
      document.addEventListener('click', async (e) => {
        const btn = e.target.closest('.copy-btn');
        if (!btn) return;
        
        const sourceText = btn.getAttribute('data-copy-source');
        if (sourceText) {
          try {
            await navigator.clipboard.writeText(sourceText);
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('!bg-[#00B060]', '!text-white');
            setTimeout(() => { 
              btn.textContent = originalText; 
              btn.classList.remove('!bg-[#00B060]', '!text-white');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy', err);
          }
        }
      });
    </script>
  </body>
</html>


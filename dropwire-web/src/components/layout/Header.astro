---
import { SITE, NAV_LINKS } from '../../lib/site';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#0B1016]/85 border-b border-[#7C6542]/30 transition-all">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand Logo & Wordmark -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="relative w-8 h-8 rounded-lg bg-[#161D24] border border-[#7C6542]/40 p-1 flex items-center justify-center group-hover:border-[#E1B865] transition-colors shadow-md overflow-hidden">
        <img src="/brand/dropwire-logo.png" alt="DropWire Logo" class="w-6 h-6 object-contain group-hover:scale-110 transition-transform" />
      </div>
      <div class="flex flex-col">
        <span class="font-display text-lg font-bold tracking-tight text-[#FEF7E4] group-hover:text-[#F3D578] transition-colors">
          DropWire
        </span>
        <span class="text-[10px] font-mono text-[#AA90B3] -mt-1 hidden sm:inline">P2P ENCRYPTED</span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-6 font-sans text-sm">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="text-[#FEF7E4]/80 hover:text-[#F3D578] font-medium transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <a
        href={SITE.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#7C6542]/40 bg-[#161D24] text-xs font-mono text-[#FEF7E4] hover:border-[#AA90B3] transition-colors"
      >
        <svg class="w-4 h-4 fill-current text-[#AA90B3]" viewBox="0 0 24 24">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
      </a>

      <a
        href="/#agent-skill"
        class="inline-flex px-3 sm:px-4 py-1.5 rounded-lg bg-[#A855F7]/20 border border-[#A855F7]/40 text-[#A855F7] text-xs font-semibold font-sans hover:bg-[#A855F7] hover:text-white transition-all shadow-md"
      >
        Get Agent Skill ↓
      </a>

      <a
        href="/download"
        class="px-4 py-1.5 rounded-lg bg-gradient-to-r from-[#E1B865] to-[#D4A95E] text-[#0B1016] text-xs font-semibold font-sans hover:brightness-110 transition-all shadow-md shadow-[rgba(225,184,101,0.2)]"
      >
        Get DropWire
      </a>
    </div>
  </div>
</header>


---
const PERFORMANCE_METRICS = [
  { label: 'Blazing Fast', detail: '4GB in 40 seconds over LAN' },
  { label: 'Auto-Resume', detail: 'Resumes instantly if WiFi drops' },
  { label: 'No Limits', detail: 'Tested on 500GB folders' },
  { label: 'Private', detail: 'Never touches a cloud server' },
];
---

<div class="w-full bg-[#FF3D00] text-white rounded-[2rem] py-5 px-6 my-4 shadow-xl">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
    <div class="flex items-center gap-2 text-[#FFB800] font-black uppercase tracking-wider text-sm">
      <span>✦</span>
      <span>REAL-WORLD PERFORMANCE:</span>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {PERFORMANCE_METRICS.map((metric) => (
        <div class="flex items-center gap-2 bg-black/20 px-3.5 py-2 rounded-full font-bold">
          <span class="text-[#FFB800]">{metric.label}</span>
          <span class="opacity-60">·</span>
          <span class="text-white/90 text-[11px]">{metric.detail}</span>
        </div>
      ))}
    </div>
  </div>
</div>

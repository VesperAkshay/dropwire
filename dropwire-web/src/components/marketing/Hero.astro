---
import HeroCube3D from '../motion/HeroCube3D';
import TerminalDemo from '../motion/TerminalDemo';
import MagneticButton from '../motion/MagneticButton';
import ScrollReveal from '../motion/ScrollReveal';
import { SITE } from '../../lib/site';
import HeroBackground from '../network/HeroBackground';
---

<section class="relative p-6 sm:p-12 overflow-hidden bg-[#FFFFFF] rounded-[2.5rem] card-shadow border border-[#D9D2C9]">
  {/* Awwwards Generative Living Network Background */}
  <HeroBackground client:only="react" />

  <div class="max-w-6xl mx-auto space-y-12 relative z-10">
    {/* Units.gr Signature Ultra-Bold Headline with Scroll Reveal */}
    <div class="text-center max-w-5xl mx-auto space-y-6 pt-4">
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#F4EFEA] border border-[#0D1117]/10 rounded-full text-xs font-mono text-black font-bold">
        <span class="w-2.5 h-2.5 rounded-full bg-[#00B060] animate-pulse"></span>
        DropWire v0.1 Engine — Encrypted P2P Streaming
      </div>

      <ScrollReveal client:only="react" direction="up" delay={100}>
        <h1 class="text-5xl sm:text-7xl lg:text-9xl font-display font-black tracking-tighter text-[#0B1016] leading-[0.92] uppercase">
          Peer to peer.<br />
          <span class="text-[#0052FF]">
            Encrypted.
          </span>{" "}
          <span class="text-[#FF3D00]">
            No cloud.
          </span>
        </h1>
      </ScrollReveal>

      <ScrollReveal client:only="react" direction="up" delay={200}>
        <p class="text-lg sm:text-2xl text-[#0B1016]/80 font-sans max-w-3xl mx-auto leading-relaxed font-bold">
          Direct file streaming machine-to-machine with end-to-end encryption and zero cloud storage.
        </p>
      </ScrollReveal>

      {/* Magnetic Overlay Pill CTAs */}
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <MagneticButton client:only="react" href="/download" strength={0.4}>
          <div class="px-9 py-4 rounded-full bg-[#FFB800] text-black font-display font-black text-lg hover:bg-[#FFD000] transition-all gold-glow flex items-center gap-2 shadow-lg cursor-pointer">
            <span>Get DropWire</span>
            <span class="text-xl">↗</span>
          </div>
        </MagneticButton>

        <MagneticButton client:only="react" href={SITE.repo} strength={0.4}>
          <div class="px-7 py-4 rounded-full bg-[#0052FF] text-white font-display font-bold text-base hover:bg-[#0042D0] transition-all flex items-center gap-2 shadow-md cursor-pointer">
            <span>View Source on GitHub</span>
            <span>↗</span>
          </div>
        </MagneticButton>
      </div>
    </div>

    {/* Hero Stage Container (Curved 3D Atropos Cube + Live Terminal) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-8">
      <div class="lg:col-span-5 flex justify-center">
        <div class="w-full bg-[#F4EFEA] p-6 rounded-[2.5rem] border-2 border-[#FFB800] flex justify-center shadow-lg">
          <HeroCube3D client:only="react" />
        </div>
      </div>
      <div class="lg:col-span-7">
        <TerminalDemo client:only="react" />
      </div>
    </div>
  </div>
</section>


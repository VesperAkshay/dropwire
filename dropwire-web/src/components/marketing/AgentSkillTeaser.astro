<section id="agent-skill" class="p-8 sm:p-14 bg-[#2D2D2D] text-white rounded-[2.5rem] shadow-2xl text-center space-y-8 my-4 border border-white/5">
  <div class="max-w-2xl mx-auto space-y-4">
    <span class="px-4 py-1.5 bg-[#A855F7]/20 text-[#A855F7] text-xs font-mono font-black uppercase rounded-full tracking-wider border border-[#A855F7]/30 inline-block mb-2">
      AI AGENT SKILL
    </span>
    <h2 class="text-4xl sm:text-5xl font-display font-black uppercase tracking-tight leading-tight">
      Teach Your AI to Use DropWire
    </h2>
    <p class="text-base text-white/80 font-sans font-medium">
      Install the official DropWire skill. Your AI agent (Claude Code, Cursor, Copilot, etc.) will instantly know how to securely send files, resume transfers, and spin up relays for you.
    </p>
  </div>

  <div class="max-w-xl mx-auto bg-black text-white p-5 rounded-full font-mono text-sm shadow-xl flex items-center justify-between gap-3 border border-white/10">
    <span class="text-[#A855F7] font-bold pl-2 truncate">$ npx skills add VesperAkshay/dropwire-skill</span>
    <div class="flex items-center gap-2 shrink-0">
      <button
        class="copy-btn px-4 py-2.5 bg-[#A855F7]/20 text-[#A855F7] rounded-full font-display font-black text-xs hover:bg-[#A855F7] hover:text-black transition-all uppercase shrink-0 border border-[#A855F7]/30"
        data-copy-source="npx skills add VesperAkshay/dropwire-skill"
      >
        Copy
      </button>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-mono font-bold text-white/50 pt-2">
    <span>Claude Code</span>
    <span>·</span>
    <span>Cursor</span>
    <span>·</span>
    <span>GitHub Copilot</span>
    <span>·</span>
    <span>Cline</span>
  </div>
</section>

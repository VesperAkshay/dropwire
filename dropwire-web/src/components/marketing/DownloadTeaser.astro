---
---

<section class="p-8 sm:p-14 bg-[#FFB800] text-black rounded-[2.5rem] shadow-2xl text-center space-y-8 my-4">
  <div class="max-w-2xl mx-auto space-y-4">
    <h2 class="text-4xl sm:text-6xl font-display font-black uppercase tracking-tight leading-tight">
      Ready to transfer files without limits?
    </h2>
    <p class="text-base text-black/90 font-sans font-bold">
      Install DropWire via Cargo or standalone binary. Works out of the box on Windows, macOS, and Linux.
    </p>
  </div>

  <div class="max-w-xl mx-auto bg-black text-white p-5 rounded-3xl font-mono text-sm shadow-xl space-y-4 border border-black">
    <div class="flex items-center justify-between gap-3 pb-3 border-b border-white/20">
      <div class="flex flex-col text-left">
        <span class="text-white/60 text-xs font-sans uppercase font-black mb-1">1. Install Core CLI</span>
        <span class="text-[#FFB800] font-bold pl-2 truncate">$ curl -sS https://dropwire.tyes.dev/install.sh | sh</span>
      </div>
      <button
        class="copy-btn px-4 py-2 bg-white/10 text-white rounded-full font-display font-black text-xs hover:bg-white hover:text-black transition-all uppercase shrink-0"
        data-copy-source="curl -sS https://dropwire.tyes.dev/install.sh | sh"
      >
        Copy
      </button>
    </div>

    <div class="flex items-center justify-between gap-3">
      <div class="flex flex-col text-left">
        <span class="text-white/60 text-xs font-sans uppercase font-black mb-1">2. Install DropWire TUI</span>
        <span class="text-[#00B060] font-bold pl-2 truncate">$ curl -sS https://dropwire.tyes.dev/install-tui.sh | sh</span>
      </div>
      <button
        class="copy-btn px-4 py-2 bg-white/10 text-white rounded-full font-display font-black text-xs hover:bg-white hover:text-black transition-all uppercase shrink-0"
        data-copy-source="curl -sS https://dropwire.tyes.dev/install-tui.sh | sh"
      >
        Copy
      </button>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-mono font-bold text-black/70 pt-2">
    <span>Windows (x64)</span>
    <span>·</span>
    <span>macOS (Apple Silicon / Intel)</span>
    <span>·</span>
    <span>Linux (x86_64 / ARM64)</span>
  </div>
</section>

